# Copy to .env.development.local and point at whichever server you're
# testing against — NOT .env.local, which Expo loads in every mode
# including production, and would silently ship this URL in a real
# TestFlight/App Store build. .env.development.local only applies to
# `expo start` / dev-client builds; a Release archive or `eas build` never
# reads it, so it always falls through to app.json's prod apiUrl instead.
#
# Production:   https://invites.falcon83.com
# Test site:    https://test-invites.falcon83.com
# Local Django: http://192.168.86.65:8000   (your Mac must be on the same LAN;
#               use your machine's LAN IP, not localhost, so the phone can reach it)
EXPO_PUBLIC_API_URL=https://invites.falcon83.com
