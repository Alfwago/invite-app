{
  "expo": {
    "name": "OBH Invites",
    "slug": "jvmalone",
    "version": "1.5.0",
    "orientation": "portrait",
    "scheme": "obhinvites",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.falcon83.obhinvites",
      "buildNumber": "22",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "associatedDomains": [
        "applinks:invites.falcon83.com",
        "applinks:test-invites.falcon83.com"
      ],
      "appleTeamId": "8977MZW8RA"
    },
    "android": {
      "package": "com.falcon83.obhinvites",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "invites.falcon83.com", "pathPrefix": "/event" },
            { "scheme": "https", "host": "invites.falcon83.com", "pathPrefix": "/messages" },
            { "scheme": "https", "host": "invites.falcon83.com", "pathPrefix": "/inbox" },
            { "scheme": "https", "host": "test-invites.falcon83.com", "pathPrefix": "/event" },
            { "scheme": "https", "host": "test-invites.falcon83.com", "pathPrefix": "/messages" },
            { "scheme": "https", "host": "test-invites.falcon83.com", "pathPrefix": "/inbox" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      [
        "./plugins/withIosDevTeam",
        "8977MZW8RA"
      ],
      "./plugins/withSceneDelegate",
      "./plugins/withPodsDeploymentTarget",
      "./plugins/withVersionVariables",
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "OBH Invites uses your photos so you can attach a picture to a message board post."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#e6b422"
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withWatchDeviceFamily"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://invites.falcon83.com",
      "router": {},
      "eas": {
        "projectId": "ccd02292-6cd0-4556-96ca-55ae6762d0e0"
      }
    },
    "owner": "alfwagos-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ccd02292-6cd0-4556-96ca-55ae6762d0e0"
    }
  }
}
