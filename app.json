{
  "expo": {
    "name": "OBH Skate Invites",
    "slug": "jvmalone",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "obhinvites",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.falcon83.obhinvites",
      "buildNumber": "1",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.falcon83.obhinvites",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d0d"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      [
        "expo-notification-service-extension-plugin",
        {
          "mode": "development",
          "iosNSEFilePath": "./assets/NotificationService.m",
          "devTeam": "8977MZW8RA",
          "iPhoneDeploymentTarget": "15.1"
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "OBH Invites uses your photos so you can attach a picture to a message board post."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#e6b422"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://invites.falcon83.com",
      "router": {},
      "eas": {
        "projectId": "ccd02292-6cd0-4556-96ca-55ae6762d0e0"
      }
    },
    "owner": "alfwagos-team"
  }
}
