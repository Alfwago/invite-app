{
  "expo": {
    "name": "OBH Skate Invites",
    "slug": "invite-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "obhinvites",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.falcon83.obhinvites"
    },
    "android": {
      "package": "com.falcon83.obhinvites"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "OBH Invites uses your photos so you can attach a picture to a message board post."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#e6b422"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://invites.falcon83.com"
    }
  }
}
